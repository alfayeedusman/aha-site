# Hostinger (Apache/LiteSpeed). Ignored by GitHub Pages.
Options -MultiViews
# Serve our index.html even if Hostinger's default index.php ("Coming soon") is still there.
DirectoryIndex index.html index.php
RewriteEngine On

# Clean URLs: /privacy -> privacy.html, /support -> support.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

ErrorDocument 404 /404.html

<IfModule mod_headers.c>
  # Hashed build assets never change.
  <If "%{REQUEST_URI} =~ m#^/_astro/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
</IfModule>
