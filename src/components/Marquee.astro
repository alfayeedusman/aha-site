---
import { Picture } from 'astro:assets';
import home from '../assets/screens/01-home.png';
import places from '../assets/screens/05-places.png';
import history from '../assets/screens/06-history.png';
import vault from '../assets/screens/07-vault.png';
import privacy from '../assets/screens/08-privacy.png';
import pin from '../assets/screens/03-pin.png';
const shots = [
  [home, 'Home'],
  [places, 'Places'],
  [history, 'Location history'],
  [vault, 'Secret Vault'],
  [privacy, 'Privacy'],
  [pin, 'Visual pin'],
] as const;
const sizes = 'clamp(170px, 22vw, 230px)';
---
<div class="marquee">
  <div class="track">
    <div class="set">
      {shots.map(([src, alt]) => <Picture src={src} formats={['avif', 'webp']} fallbackFormat="webp" widths={[230, 460]} sizes={sizes} alt={alt} loading="lazy" />)}
    </div>
    <div class="set" aria-hidden="true">
      {shots.map(([src]) => <Picture src={src} formats={['avif', 'webp']} fallbackFormat="webp" widths={[230, 460]} sizes={sizes} alt="" loading="lazy" />)}
    </div>
  </div>
</div>

<style>
  .marquee {
    overflow: hidden;
    margin: 0 calc(-1 * var(--gutter));
    padding: 8px 0 14px;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
  }
  .track {
    display: flex;
    width: max-content;
    animation: aha-marquee 45s linear infinite;
  }
  .track:hover { animation-play-state: paused; }
  .set { display: flex; gap: 18px; padding-right: 18px; } /* trailing gap keeps the -50% loop seamless */
  .marquee :global(img) {
    flex: none;
    width: clamp(170px, 22vw, 230px);
    height: auto;
    border-radius: 24px;
    box-shadow: var(--shadow-strip);
  }
</style>
