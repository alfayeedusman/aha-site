---
import '../styles/tokens.css';
import '../styles/global.css';
import '../styles/motion.css';
import bricolage from '../assets/fonts/bricolage-grotesque-latin.woff2?url';
import figtree from '../assets/fonts/figtree-latin.woff2?url';
import { config, url } from '../config';

interface Props {
  title: string;
  description: string;
  /** Canonical path relative to the base, e.g. "" or "privacy". */
  path?: string;
  noindex?: boolean;
  reveal?: boolean;
}
const { title, description, path = '', noindex = false, reveal = false } = Astro.props;
const canonical = new URL(url(path), Astro.site).href;
const ogImage = new URL(url('og.png'), Astro.site).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#F5FAF8" />
    {config.appStoreId && <meta name="apple-itunes-app" content={`app-id=${config.appStoreId}`} />}

    <link rel="icon" href={url('favicon.ico')} sizes="32x32" />
    <link rel="icon" href={url('icon/AppIcon-180.png')} type="image/png" />
    <link rel="apple-touch-icon" href={url('apple-touch-icon.png')} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={config.appName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="aha! — You put it somewhere safe. aha! remembers where." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preload" href={bricolage} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={figtree} as="font" type="font/woff2" crossorigin />
    {reveal && (
      <script is:inline>
        if ('IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('reveal');
      </script>
    )}
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
  </body>
</html>
