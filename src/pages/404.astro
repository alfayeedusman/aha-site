---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { url } from '../config';
---
<Base title="Not found · aha! - Where I Put It" description="This page doesn't exist." path="404" noindex>
  <Header onHome={false} />
  <main id="main" class="nf">
    <div class="eyebrow">404</div>
    <h1>We looked everywhere.</h1>
    <p>This page isn't here. aha! never guesses, so let's head back home.</p>
    <a href={url('')}>Back to home</a>
  </main>
  <Footer />
</Base>

<style>
  .nf {
    max-width: 720px;
    margin: 0 auto;
    padding: clamp(64px, 12vw, 120px) var(--gutter);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 18px;
  }
  h1 { margin: 0; font: 800 clamp(38px, 5vw, 56px) / 1.02 var(--font-head); letter-spacing: -0.035em; }
  p { margin: 0; font: 500 18px/1.5 var(--font-body); color: var(--muted); }
  a {
    height: 50px;
    padding: 0 22px;
    border-radius: 25px;
    background: var(--ink);
    color: #fff;
    display: flex;
    align-items: center;
    font: 700 15px var(--font-body);
  }
  a:hover { color: #fff; }
</style>
