---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Features from '../components/Features.astro';
import PrivacyBand from '../components/PrivacyBand.astro';
import ClosingCta from '../components/ClosingCta.astro';
import Faq from '../components/Faq.astro';
---
<Base
  title="aha! - Where I Put It · One less thing to remember"
  description="aha! remembers where you put things. Snap it, pin the spot, then just ask. Private on your iPhone."
  reveal
>
  <Header />
  <main id="main">
    <Hero />
    <HowItWorks />
    <Features />
    <PrivacyBand />
    <ClosingCta />
    <Faq />
  </main>
  <Footer />
</Base>
<script>import '../components/Reveal';</script>
